# PLACEHOLDER: This file should be generated by nixos-generate-config
#
# Run this command on the target machine to generate the hardware configuration:
#   sudo nixos-generate-config --show-hardware-config > /etc/nixos/hosts/kafka/hardware-configuration.nix
#
# This file will contain:
# - Boot kernel modules specific to your hardware
# - Root filesystem and boot partition UUIDs
# - Swap device configuration
# - CPU microcode updates (Intel/AMD)
# - Other hardware-specific settings
#
# Do not manually edit this file after generation. All custom configuration
# should go in configuration.nix instead.

{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  # FIXME: Replace these with values from nixos-generate-config
  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "usbhid"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ ];
  boot.extraModulePackages = [ ];

  # FIXME: Replace with actual root filesystem UUID (kernels live in /boot on this partition for BIOS/MBR)
  fileSystems."/" = {
    device = "/dev/disk/by-uuid/REPLACE-WITH-ROOT-UUID";
    fsType = "ext4";
  };

  # No separate /boot vfat — that is for EFI. If you use a dedicated ext4 /boot partition,
  # add it here (from nixos-generate-config on the machine).

  # FIXME: Replace with actual swap device UUID (or remove if no swap)
  swapDevices = [
    { device = "/dev/disk/by-uuid/REPLACE-WITH-SWAP-UUID"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  # FIXME: Uncomment if using AMD CPU
  # hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
  # FIXME: Uncomment if using Intel CPU
  # hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
