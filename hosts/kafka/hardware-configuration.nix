# Do not modify this file!  It was generated by 'nixos-generate-config'
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
#
# NOTE: This file is a template for the next install (impermanence + btrfs + LUKS,
# BIOS/GRUB layout with a separate unencrypted /boot partition).
# UUIDs must be replaced with the values generated by `nixos-generate-config`
# after the new install.
{
  config,
  lib,
  modulesPath,
  ...
}:

let
  # UUID of the raw LUKS partition (blkid: the partition containing the LUKS header)
  luksUuid = "REPLACE-WITH-LUKS-PARTITION-UUID-AT-INSTALL";
  # Opened LUKS mapper device — btrfs lives inside this
  btrfsDevice = "/dev/mapper/cryptroot";
  # No "ssd" flag: kafka is likely on a spinning disk; let btrfs auto-detect.
  btrfsOptions = [
    "compress=zstd:3"
    "noatime"
    "space_cache=v2"
  ];
in
{
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.initrd.availableKernelModules = [
    "ahci"
    "ohci_pci"
    "ehci_pci"
    "pata_atiixp"
    "usbhid"
    "floppy"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [ "dm-crypt" ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];

  # LUKS encryption — passphrase prompted by GRUB or initrd
  boot.initrd.luks.devices."cryptroot" = {
    device = "/dev/disk/by-uuid/${luksUuid}";
  };

  fileSystems."/" = {
    device = btrfsDevice;
    fsType = "btrfs";
    options = [ "subvol=@" ] ++ btrfsOptions;
  };

  fileSystems."/nix" = {
    device = btrfsDevice;
    fsType = "btrfs";
    options = [ "subvol=@nix" ] ++ btrfsOptions;
  };

  fileSystems."/persist" = {
    device = btrfsDevice;
    fsType = "btrfs";
    options = [ "subvol=@persist" ] ++ btrfsOptions;
    neededForBoot = true;
  };

  # Separate unencrypted /boot partition (BIOS/GRUB cannot decrypt LUKS2)
  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/REPLACE-WITH-BOOT-UUID-AT-INSTALL";
    fsType = "ext4";
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
