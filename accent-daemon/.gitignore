# --- Build Artifacts ---
# The target directory contains all compiled code, dependencies, and binaries.
# This can grow to several gigabytes quickly.
/target/

# --- Backup Files ---
# These are generated by cargo when you run 'cargo fix' or 'cargo fmt'
**/*.rs.bk

# --- IDE & Editor Specific ---
# JetBrains / IntelliJ / PyCharm / RustRover
.idea/
*.iml

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim / Emacs
*~
*.swp
*.swo

# --- OS Specific ---
.DS_Store
Thumbs.db

# --- Optional: Cargo Lock ---
# For BINARY projects (apps), you SHOULD commit Cargo.lock.
# For LIBRARY projects, it is often ignored, though opinions vary.
# Uncomment the line below if you are strictly making a library.
# Cargo.lock