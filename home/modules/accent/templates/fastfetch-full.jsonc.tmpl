{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "@LOGO_PATH@",
    "color": {
      "1": "34"
    },
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "34"
    },
    "key": {
      "width": 3
    }
  },
  "modules": [
    { "type": "break" },
    { "type": "break" },
    { "type": "break" },
    {
      "type": "title",
      "color": {
        "user": "34",
        "at": "34",
        "host": "34"
      }
    },
    { "type": "break" },
    { "type": "os",     "key": "◆ ", "keyColor": "34" },
    { "type": "kernel", "key": "◆ ", "keyColor": "34" },
    { "type": "cpu",    "key": "◆ ", "keyColor": "34" },
    { "type": "gpu",    "key": "◆ ", "keyColor": "34" },
    { "type": "memory", "key": "◆ ", "keyColor": "34" },
    { "type": "disk",   "key": "◆ ", "keyColor": "34" }
  ]
}
