/* Generated by paletted — do not edit by hand.
   Rendered to ~/.config/accent/zen-userchrome.css on every accent/mode change.
   Bridged into the active Zen profile by home-manager's zenBridgeProfile activation. */

:root {
  /* ── Zen native theme variables ── */
  --zen-primary-color: @BASE0D@ !important;
  --zen-branding-dark: @BASE00@ !important;
  --zen-main-browser-background: @BASE00@ !important;
  --zen-main-browser-background-toolbar: @BASE00@ !important;
  --zen-themed-toolbar-bg-transparent: @BASE00@ !important;
  --zen-colors-border: @BASE00@ !important;
  --zen-colors-border-contrast: rgba(@BASE03_RGB@, 0.15) !important;

  /* ── Toolbar / tab bar (the vertical sidebar in Zen) ── */
  --toolbar-bgcolor: @BASE00@ !important;
  --toolbar-color: @BASE05@ !important;
  --toolbox-textcolor: @BASE05@ !important;
  --toolbarbutton-hover-background: rgba(@BASE05_RGB@, 0.08) !important;
  --zen-toolbar-element-bg: rgba(@BASE05_RGB@, 0.08) !important;

  /* ── Tab backgrounds ── */
  --tab-selected-bgcolor: @BASE02@ !important;
  --tab-hover-background-color: rgba(@BASE05_RGB@, 0.08) !important;

  /* ── Panels / popups ── */
  --arrowpanel-background: @BASE01@ !important;
  --arrowpanel-color: @BASE05@ !important;
  --arrowpanel-border-color: @BASE03@ !important;
  --panel-background: @BASE01@ !important;
  --panel-color: @BASE05@ !important;
  --panel-border-color: @BASE03@ !important;
  --popup-background-color: @BASE01@ !important;
  --popup-color: @BASE05@ !important;
  --menuitem-hover-background-color: rgba(@BASE0D_RGB@, 0.15) !important;

  /* ── Accent / focus ── */
  --focus-outline-color: @BASE0D@ !important;
  --zen-appcontent-border: none !important;
}

/* Force the navigator-toolbox (vertical tab sidebar) background */
#navigator-toolbox {
  --zen-navigator-toolbox-background: @BASE00@ !important;
  background: @BASE00@ !important;
}

/* Main app wrapper — this is the outermost colored shell */
#zen-main-app-wrapper {
  background: @BASE00@ !important;
}

/* Generic background pseudo-element that Zen uses for the main bg */
.zen-browser-generic-background::after {
  background: @BASE00@ !important;
}

/* Content area border (the border between sidebar and page) */
#tabbrowser-tabbox #tabbrowser-tabpanels .browserSidebarContainer {
  box-shadow: none !important;
}

/* Sidebar splitter (thin resize handle) */
#zen-sidebar-splitter {
  background: transparent !important;
}
#zen-sidebar-splitter:hover::before {
  background: @BASE0D@ !important;
}

/* URL bar */
#urlbar-background {
  background-color: @BASE02@ !important;
  border-color: @BASE03@ !important;
}

/* Dropdown panels and context menus */
panel,
menupopup,
.autocomplete-richlistbox {
  --panel-background: @BASE01@ !important;
  --panel-color: @BASE05@ !important;
  --arrowpanel-background: @BASE01@ !important;
  --arrowpanel-color: @BASE05@ !important;
  background-color: @BASE01@ !important;
  color: @BASE05@ !important;
}

menuitem:hover,
.urlbarView-row[selected],
.urlbarView-row:hover {
  background-color: rgba(@BASE0D_RGB@, 0.15) !important;
}
