# ── General ──────────────────────────────────────────────────────────────
[General]
ColorScheme=AccentSync
Name=AccentSync
shadeSortColumn=true

[KDE]
contrast=4
widgetStyle=breeze

# ── Window manager decorations ───────────────────────────────────────────
[WM]
activeBackground=26,26,26
activeBlend=13,13,13
activeForeground=224,224,255
inactiveBackground=13,13,13
inactiveBlend=13,13,13
inactiveForeground=140,140,160

# ── Icons ─────────────────────────────────────────────────────────────────
[Icons]
Theme=breeze-dark
