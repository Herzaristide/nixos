# KDE Color Scheme — generated by accent-sync — do not edit by hand.
# To change the accent, run: accent-sync "#rrggbb"
# Accent: @ACCENT@

[ColorScheme]
Name=AccentSync

# ── Buttons ─────────────────────────────────────────────────────────────
[Colors:Button]
BackgroundAlternate=26,26,26
BackgroundNormal=26,26,26
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@
ForegroundActive=224,224,255
ForegroundInactive=140,140,160
ForegroundLink=@ACCENT_RGB@
ForegroundNegative=204,68,68
ForegroundNeutral=180,150,70
ForegroundNormal=224,224,255
ForegroundPositive=68,170,136
ForegroundVisited=150,100,200

# ── Complementary (used by some panel widgets) ────────────────────────────
[Colors:Complementary]
BackgroundAlternate=26,26,26
BackgroundNormal=13,13,13
DecorationFocus=@ACCENT_RGB@
DecorationHover=@ACCENT_RGB@
ForegroundActive=224,224,255
ForegroundInactive=140,140,160
ForegroundLink=@ACCENT_RGB@
ForegroundNegative=204,68,68
ForegroundNeutral=180,150,70
ForegroundNormal=224,224,255
ForegroundPositive=68,170,136
ForegroundVisited=150,100,200

