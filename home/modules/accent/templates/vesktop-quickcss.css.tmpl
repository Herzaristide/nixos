/* Generated by accent-sync — do not edit by hand.
   Recolors Vesktop/Discord's brand accent to the system accent color.
   Reload Vesktop (Ctrl+R) after accent-sync runs to apply changes.    */

:root,
.theme-dark,
.theme-light {
  /* ── Translucent low-opacity variants (hover / focus backgrounds) ──── */
  --brand-experiment-100: color-mix(in srgb, @ACCENT@ 10%, transparent);
  --brand-experiment-130: color-mix(in srgb, @ACCENT@ 13%, transparent);
  --brand-experiment-160: color-mix(in srgb, @ACCENT@ 16%, transparent);
  --brand-experiment-200: color-mix(in srgb, @ACCENT@ 20%, transparent);
  --brand-experiment-230: color-mix(in srgb, @ACCENT@ 23%, transparent);
  --brand-experiment-260: color-mix(in srgb, @ACCENT@ 26%, transparent);

  /* ── Muted mid-tone variants ────────────────────────────────────────── */
  --brand-experiment-300: @ACCENT_MUTED@;
  --brand-experiment-330: @ACCENT_MUTED@;
  --brand-experiment-360: @ACCENT_MUTED@;
  --brand-experiment-400: @ACCENT_MUTED@;
  --brand-experiment-430: @ACCENT_MUTED@;
  --brand-experiment-460: @ACCENT_MUTED@;

  /* ── Main accent ────────────────────────────────────────────────────── */
  --brand-experiment:     @ACCENT@;
  --brand-experiment-500: @ACCENT@;
  --brand-experiment-530: @ACCENT@;
  --brand-experiment-560: @ACCENT@;

  /* ── Darker pressed / active variants ──────────────────────────────── */
  --brand-experiment-600: @ACCENT_DARK@;
  --brand-experiment-630: @ACCENT_DARK@;
  --brand-experiment-660: @ACCENT_DARK@;
  --brand-experiment-700: @ACCENT_DARK@;
  --brand-experiment-730: @ACCENT_DARK@;
  --brand-experiment-760: @ACCENT_DARK@;
  --brand-experiment-800: @ACCENT_DARK@;
  --brand-experiment-830: @ACCENT_DARK@;
  --brand-experiment-860: @ACCENT_DARK@;
  --brand-experiment-900: @ACCENT_DARK@;

  /* ── Legacy brand variables (older Discord element names) ───────────── */
  --brand-500: @ACCENT@;
  --brand-560: @ACCENT@;
  --brand-600: @ACCENT_DARK@;
}
